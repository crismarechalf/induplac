# Copiar a .env y cambiar TODOS los valores CAMBIAR. .env nunca se sube a GitHub.
# En la EC2, deploy/user-data.sh genera este archivo solo.
DB_PASSWORD=CAMBIAR
# 32 caracteres o más. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR
GATEWAY_OFICINA_RM_SECRET=CAMBIAR
GATEWAY_PLANTA_SECRET=CAMBIAR
# Demo con reloj acelerado: 3. Operación real: 900 (15 min).
CICLO_SEG=3
ZONA_HORARIA=America/Santiago
# Días de mediciones que se conservan (reloj de las lecturas; mínimo 29).
RETENCION_DIAS=60

# Usuarios del dashboard (se crean al primer arranque, solo si no hay ninguno).
# ADMIN_USUARIO entra con ADMIN_CLAVE y ve la consola de operación y la auditoría.
# jefatura, prevencion, personal_rm y personal_planta entran con USUARIOS_CLAVE.
# Cambiar una clave después: docker compose exec api python -m app.usuarios cambiar-clave <usuario>
ADMIN_USUARIO=admin
ADMIN_CLAVE=CAMBIAR
USUARIOS_CLAVE=CAMBIAR
# Alias de la versión anterior: si faltan ADMIN_* / USUARIOS_CLAVE, la API usa estos.
# DEMO_USUARIO=
# DEMO_CLAVE=

# HTTPS con Caddy + DuckDNS (solo en la EC2).
DOMINIO=CAMBIAR.duckdns.org
URL_PUBLICA=https://CAMBIAR.duckdns.org
# Servicios extra en la EC2: gateways simulados y Caddy (HTTPS).
# COMPOSE_PROFILES=gateways,https

# Avisos por correo (Gmail: puerto 587 STARTTLS o 465 SSL, con contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Varios correos separados por coma. Vacío = se avisa a SMTP_USER.
ALERTA_DESTINO=
# Máximo 1 correo por sede y variable cada N minutos.
ALERTA_ENFRIAMIENTO_MIN=10
